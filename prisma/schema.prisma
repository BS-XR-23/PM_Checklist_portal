generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TPM
  PROGRAM_MANAGER
  CLIENT
  PM
  LIMITED
}

enum ModuleName {
  DASHBOARD
  PM_CHECKLIST
  DEVOPS_CHECKLIST
  ENGINEERING_CHECKLIST
  QA_CHECKLIST
  CREATIVE_XR_CHECKLIST
  MILESTONES
  RISK_REGISTER
  CR_LOG
  BUDGET_TRACKER
  PM_PLAN
  DECISION_LOG
  ACTION_ITEMS
  DELIVERY
  DEPENDENCIES
  DEV_CHECKLIST
  RELEASE
  UAT
}

enum MilestoneType {
  PLANNING
  DESIGN
  DEVELOPMENT
  QA
  UAT
  RELEASE
  CUSTOM
}

enum ReleaseType {
  INTERNAL
  DEVELOPMENT
  QA
  STAGING
  UAT
  PRODUCTION
  HOTFIX
}

enum AccessLevel {
  NONE
  READ_LIMITED
  READ_FULL
  WRITE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(LIMITED)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships             ProjectMembership[]
  auditLogs               AuditLog[]
  escalationsRaised       EscalationItem[]
  person                  Person?
  presalesProjectsCreated PresalesProject[]
  programOversights       ProgramOversight[]
}

model Project {
  id                 String        @id @default(cuid())
  name               String
  client             String?
  contractValue      Float         @default(0)
  // Feeds only manDayRate()'s "Man-Day Rate (auto)" display line on Budget
  // Tracker — a reference rate input, not a sizing baseline. plannedStoryPoints
  // below is what Sprint/Budget Tracker's PV/EV percentages actually divide by.
  plannedManDays     Float         @default(0)
  plannedStoryPoints Float         @default(0)
  crRate             Float         @default(0)
  status             ProjectStatus @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  checklistItems    ChecklistItem[]
  risks             RiskItem[]
  changeRequests    ChangeRequest[]
  pmPlan            PMPlan?
  memberships       ProjectMembership[]
  auditLogs         AuditLog[]
  escalations       EscalationItem[]
  engagements       ProjectEngagement[]
  decisions         DecisionLogItem[]
  actionItems       ActionItem[]
  wonFromPresales   PresalesProject?
  wbsTasks          WbsTask[]
  sprints           Sprint[]
  programOversights ProgramOversight[]
  dependencies      DependencyItem[]
  milestones        Milestone[]
  releases          Release[]
  uatCases          UatCase[]
  uatDefects        UatDefect[]
}

/// Organizational-only mapping of which projects a PROGRAM_MANAGER oversees.
/// Deliberately does NOT grant access — a PROGRAM_MANAGER's actual access
/// stays the blanket "portfolio-only, no project drill-down" rule in
/// rbac-core.ts (computeProjectAccess/computeModuleAccess never consult this
/// table), so adding or removing a row here can never widen or narrow what
/// they can open. It exists purely so "who oversees what" is a recorded fact
/// instead of tribal knowledge, and to give a future "My Programs" filter on
/// the Portfolio page something to filter by.
model ProgramOversight {
  id               String   @id @default(cuid())
  programManagerId String
  programManager   User     @relation(fields: [programManagerId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([programManagerId, projectId])
  @@index([projectId])
}

/// A user's access to one specific project. Only meaningful for PM/CLIENT/LIMITED
/// roles — ADMIN/TPM/PROGRAM_MANAGER get their scope from their global Role alone
/// and don't need a row here.
model ProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  permissions ModulePermission[]

  @@unique([userId, projectId])
}

/// Per-module access override, consulted only for CLIENT / LIMITED members.
/// Absence of a row means NONE (secure by default).
model ModulePermission {
  id           String            @id @default(cuid())
  membershipId String
  membership   ProjectMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  module       ModuleName
  access       AccessLevel

  @@unique([membershipId, module])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actorRole  Role
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  summary    String
  diff       Json?
  isOverride Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([actorId])
  @@index([createdAt])
}

/// TPM's dedicated write surface — deliberately never touches the 7 project-data
/// tables, so a TPM cannot silently edit a PM's checklist/milestone/risk/CR/budget.
model EscalationItem {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  title       String
  notes       String?
  status      String   @default("Open")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model ChecklistItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String // "PM" | "DEVOPS" -- see lib/constants.ts
  order         Int
  stage         String
  itemText      String
  milestoneName String?
  owner         String? // legacy free-text name; prefer ownerPersonId once set
  ownerPersonId String?
  ownerPerson   Person?   @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  plannedDate   DateTime?
  actualDate    DateTime?
  link          String?
  status        String    @default("NOT_STARTED") // see ItemStatus in lib/constants.ts
  notes         String?
  isCustom      Boolean   @default(false) // true only for items added via "+ Add Item" / "Add Milestone", never the fixed template

  // Optional links into the Delivery restructure's data model — a checklist
  // item may (not must) evidence a Milestone/WbsTask/Sprint without
  // duplicating any of their data.
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  wbsTaskId   String?
  wbsTask     WbsTask?   @relation(fields: [wbsTaskId], references: [id], onDelete: SetNull)
  sprintId    String?
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  milestonePayment MilestonePayment?

  @@unique([projectId, type, order])
}

/// The editable master checklist — lib/create-project.ts copies this into a
/// new project's ChecklistItem rows once, at creation. Deliberately has no
/// relation back to Project/ChecklistItem: editing or deleting a row here
/// only affects projects created afterward, never existing ones.
model ChecklistTemplateItem {
  id            String  @id @default(cuid())
  type          String // "PM" | "DEVOPS" -- see ChecklistType in lib/constants.ts
  order         Int
  stage         String
  itemText      String
  milestoneName String?

  @@unique([type, order])
}

model MilestonePayment {
  id              String        @id @default(cuid())
  checklistItemId String        @unique
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  // Nullable for now, additive — backfilled onto every existing row by the
  // Milestone-model migration, then tightened to be the required/unique
  // anchor (and checklistItemId relaxed to optional) in a later migration
  // once that backfill has been verified. See prisma/migrations backfill
  // script + schema.prisma history for the two-step plan.
  milestoneId   String?    @unique
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  paymentPct    Float      @default(0)
  invoiceStatus String     @default("Not Invoiced")
  clientSignoff String     @default("Pending")
  notes         String?
}

model RiskItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String    @default("Risk")
  category      String?
  description   String
  probability   String    @default("Medium")
  impact        String    @default("Medium")
  owner         String? // legacy free-text name; prefer ownerPersonId once set
  ownerPersonId String?
  ownerPerson   Person?   @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  mitigation    String?
  status        String    @default("Open")
  dateRaised    DateTime?
  dateClosed    DateTime?
  notes         String?
  order         Int       @default(0)

  @@index([projectId])
}

/// Append-only record of "what did we decide and why" — distinct from
/// ChangeRequest (scope changes only) and from ChecklistItem (the fixed,
/// formal stage-gated backbone). Freestanding in v1, no link to a
/// Risk/CR.
model DecisionLogItem {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order             Int       @default(0)
  date              DateTime?
  decision          String
  rationale         String?
  decidedBy         String? // legacy free-text name; prefer decidedByPersonId once set
  decidedByPersonId String?
  decidedByPerson   Person?   @relation(fields: [decidedByPersonId], references: [id], onDelete: SetNull)
  notes             String?

  @@index([projectId])
}

/// Lightweight follow-ups that fall out of a call/meeting — too small for
/// a formal Checklist entry, but still need an owner and a due date so
/// they don't get forgotten.
model ActionItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order         Int       @default(0)
  description   String
  ownerPersonId String?
  ownerPerson   Person?   @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  owner         String? // legacy free-text name; prefer ownerPersonId once set
  dueDate       DateTime?
  status        String    @default("Open") // "Open" | "Done"
  notes         String?

  @@index([projectId])
}

/// Things this project is waiting on from the client, another internal
/// team, or a third-party company (assets, access, sign-off) before work
/// can proceed — distinct from RiskItem (a risk to the project) and
/// ActionItem (an internal follow-up): a dependency is owned by someone
/// outside the delivery team's control.
model DependencyItem {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order           Int       @default(0)
  category        String?
  description     String
  preferredFormat String?
  responsible     String? // free-text org/party name, e.g. "Khalifa Fund" or "Brain Station" — not a Person, since these are organizations, not individuals
  priority        String    @default("Medium")
  expectedDate    DateTime?
  status          String    @default("Due") // "Due" | "Done"
  notes           String?

  @@index([projectId])
}

model ChangeRequest {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crCode          String
  title           String
  dateRaised      DateTime?
  description     String?
  manDaysPlanned  Float?
  billableManDays Float?
  rate            Float?
  type            String    @default("Paid")
  clientSignoff   String    @default("Pending")
  wbsUpdated      String    @default("No")
  status          String    @default("Proposed")
  notes           String?

  @@unique([projectId, crCode])
}

// Admin-managed rate card, by role — not by named person, so no
// salary-like data is stored against an individual. Budget Tracker resolves
// each sprint-committed WbsTask's assignee to their RoleRate live, at read
// time (not snapshotted — Budget Tracker is a "testing purposes only"
// derived view, not the authoritative cost record, so drift on
// rename/rate-change is an acceptable trade against duplicating
// Competency's snapshot machinery).
model RoleRate {
  id         String   @id @default(cuid())
  roleName   String   @unique
  manDayRate Float
  createdAt  DateTime @default(now())

  people Person[]
}

// Velocity/capacity multiplier — separate axis from RoleRate. RoleRate
// drives currency cost; Competency never touches currency, it converts
// real days worked into "standard effort units" (1.0 = baseline/Mid,
// 1.3 = Senior finishes the same estimated work ~30% faster) for the
// Delivery tab's Competency CPI (EV/AV).
model Competency {
  id         String   @id @default(cuid())
  level      String   @unique // "Intern/Junior<6", "Junior 1B", "Mid", "Senior", "PM"
  multiplier Float
  createdAt  DateTime @default(now())

  people Person[]
}

// The project-wide WBS master list — defined once (Tasks tab). storyPoints
// is the sole estimate unit (drives Sprint's PV and 0/100 EV rule).
// personId is the default/suggested assignee. sprintId optionally commits
// this task to a Sprint's backlog at planning time, giving an explicit
// Planned Value baseline. Once committed, pctComplete/actualHours track
// its progress directly (no more weekly checkpoint rows) — pctComplete is
// a human judgment of real progress, always set independently of hours;
// actualHours is manually typed in (e.g. read off Jira) and converted to a
// man-days-equivalent (see manDaysFromHours in lib/calculations.ts) to
// feed Actual Value, alongside competencyMultiplier, snapshotted from the
// assignee's Competency when they're assigned (a later Competency edit
// must never rewrite an already-tracked Actual Value). These fields carry
// over naturally if a task's sprintId changes (normal Scrum carry-over) —
// deliberately not reset by moving sprints, since real progress doesn't
// reset just because the sprint changed.
model WbsTask {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNumber            String
  title                String
  storyPoints          Float    @default(0)
  personId             String?
  person               Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  personName           String?
  sprintId             String?
  sprint               Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  pctComplete          Float    @default(0)
  actualHours          Float    @default(0)
  // actualHours baseline snapshotted at the moment this task was last
  // committed to its current sprint — actualHours is a lifetime-cumulative
  // value (the Task tab always shows it in full), so a sprint's own Actual
  // Value must use (actualHours - sprintEntryHours), not actualHours
  // directly, or a task moved mid-flight would bring its whole history with
  // it. See sprintOwnHours() in lib/calculations.ts.
  sprintEntryHours     Float    @default(0)
  competencyMultiplier Float    @default(1)
  createdAt            DateTime @default(now())

  // Optional link to the Delivery restructure's Milestone model — a WBS
  // task may roll up under a milestone without duplicating its data.
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  checklistItems ChecklistItem[]
  releases       ReleaseWbsTask[]

  @@index([projectId])
  @@index([sprintId])
  @@index([milestoneId])
}

// A Scrum sprint — a WbsTask committed to one (sprintId) gets an explicit
// Planned Value baseline at commit time. Earned Value follows the 0/100
// rule (a committed task earns its full storyPoints once its latest
// tracked % reaches 100%, else 0).
//
// closedAt is the whole point: while null, PV/EV/AV are computed live from
// current WbsTask state (see sprintEarnedValue in calculations.ts). Once
// closeSprint() sets it, the frozen* fields (including frozenTaskSnapshot,
// the drill-down list at close time) are a permanent record the UI reads
// directly instead of recomputing — so a task carrying over into a later
// sprint, or being edited afterward, can never silently rewrite this
// sprint's already-reported numbers or which tasks earned them. A closed
// sprint can only be reopened by an Admin (reopenSprint in
// delivery-actions.ts); while closed, a task can't be committed into or
// removed from it.
model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  closedAt            DateTime?
  frozenPlannedPoints Float?
  frozenEarnedPoints  Float?
  frozenActualValue   Float?
  frozenTaskSnapshot  Json?
  // Tasks detached from this sprint (moved elsewhere, or uncommitted to the
  // backlog) *while it was still open* — each entry freezes that task's
  // contribution (points/pctComplete/its own actual hours/cost) at the
  // moment it left, keyed by taskId (at most one entry per task; a task
  // that returns to this sprint has its entry removed, since its live row
  // covers it again). Without this, an open sprint's live PV/EV/AV would
  // silently drop a task's contribution the instant it moved elsewhere,
  // with zero trace it was ever here. Folded into frozenTaskSnapshot's
  // union (with the still-live tasks) the moment this sprint is closed —
  // see closeSprint() and sprintContributionEntries() in calculations.ts.
  departedTaskSnapshot Json @default("[]")

  tasks          WbsTask[]
  allocations    SprintAllocation[]
  checklistItems ChecklistItem[]
  milestones     MilestoneSprint[]
  releases       ReleaseSprint[]

  @@index([projectId])
}

// Per-person capacity cross-check for a sprint, matching the original
// Person/Allocation%/Jira-Hour layout this feature was modeled on.
// jiraHours is manually typed in by the PM (no live Jira API integration)
// and is deliberately reference-only — it never feeds PV/EV/AV, so there's
// no risk of a second, unreconciled source of truth for the Sprint's
// numbers. Locked once the sprint is closed, same as the rest of Sprint.
model SprintAllocation {
  id            String   @id @default(cuid())
  sprintId      String
  sprint        Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  allocationPct Float    @default(1)
  jiraHours     Float?
  createdAt     DateTime @default(now())

  @@unique([sprintId, personId])
  @@index([sprintId])
}

model PMPlan {
  id         String    @id @default(cuid())
  projectId  String    @unique
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preparedBy String?
  planDate   DateTime?
  version    String    @default("1.0")
  updatedAt  DateTime  @default(now()) @updatedAt
  rationale  String?

  charterObjective       String?
  charterScopeIn         String?
  charterScopeOut        String?
  charterSuccessCriteria String?
  charterTimeline        String?
  charterBudget          String?
  charterAssumptions     String?
  charterPmAuthority     String?

  methodApproach   String?
  methodCadence    String?
  methodCeremonies String?
  methodTools      String?
  methodRoles      String?
  methodChangeMgmt String?

  testLevels        String?
  testEnvironments  String?
  testEntryCriteria String?
  testExitCriteria  String?
  testDefectMgmt    String?
  testUatProcess    String?
  testDeliverables  String?

  deployEnvironments    String?
  deployReleaseStrategy String?
  deploySteps           String?
  deployRollback        String?
  deployGoliveChecklist String?
  deployMonitoring      String?

  escalationPath String?

  stakeholders StakeholderRow[]
  commsRows    CommsRow[]
  raciRows     RaciRow[]
  links        PmPlanLink[]
}

/// One optional reference link per scalar PMPlan field — kept as a side
/// table rather than a `<field>Link` column per field, since only a subset
/// of PMPlan's ~29 fields actually gets this (the long-form ones where the
/// real detail usually lives in an external doc). `field` is one of
/// PmPlanScalarField (lib side, not DB-enforced) — see pmplan-actions.ts.
model PmPlanLink {
  id       String @id @default(cuid())
  pmPlanId String
  pmPlan   PMPlan @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  field    String
  url      String

  @@unique([pmPlanId, field])
}

model StakeholderRow {
  id             String  @id @default(cuid())
  pmPlanId       String
  pmPlan         PMPlan  @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  order          Int
  stakeholder    String // legacy free-text name/label; prefer personId once set
  personId       String?
  person         Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  role           String
  responsibility String
  accessRequired String
}

model CommsRow {
  id        String @id @default(cuid())
  pmPlanId  String
  pmPlan    PMPlan @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  order     Int
  audience  String
  frequency String
  channel   String
  content   String
}

model RaciRow {
  id           String @id @default(cuid())
  pmPlanId     String
  pmPlan       PMPlan @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  order        Int
  activity     String
  pm           String
  tl           String
  ba           String
  leadEng      String
  creativeLead String
}

/// Canonical registry of a real person — the single source of truth that
/// checklist "Owner", risk "Owner", and stakeholder names should reference
/// instead of re-typing free text on every row.
model Person {
  id           String      @id @default(cuid())
  name         String
  title        String? // e.g. "Lead Engineer", "Creative Lead", "QA", "BA"
  email        String?
  phone        String?
  userId       String?     @unique // linked portal account, if they have one (typically LIMITED)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  roleRateId   String? // which RoleRate this person's Actual Cost logging resolves to
  roleRate     RoleRate?   @relation(fields: [roleRateId], references: [id], onDelete: SetNull)
  competencyId String? // which Competency multiplier this person's WBS Actual Value resolves to
  competency   Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  engagements             ProjectEngagement[]
  checklistOwners         ChecklistItem[]
  riskOwners              RiskItem[]
  stakeholderRows         StakeholderRow[]
  decisionsMade           DecisionLogItem[]
  actionItemOwner         ActionItem[]
  presalesDecisionsMade   PresalesDecisionItem[]
  presalesActionItemOwner PresalesActionItem[]
  presalesChecklistOwner  PresalesChecklistItem[]
  wbsTasks                WbsTask[]
  sprintAllocations       SprintAllocation[]
  milestoneOwner          Milestone[]
  releaseOwner            Release[]
  uatCaseOwner            UatCase[]
  uatDefectOwner          UatDefect[]
}

enum PresalesOutcome {
  OPEN
  WON
  LOST
}

/// A pre-contract opportunity — deliberately NOT a Project (no checklist,
/// milestones, risk, budget, or PM Plan). Tracks just enough to reason about
/// a deal before it's signed. On Win, createProject() (lib/create-project.ts)
/// seeds a real Project the normal way and this row links to it via
/// wonProjectId; on Lost, the row is kept (not deleted) as win/loss history.
model PresalesProject {
  id                String          @id @default(cuid())
  name              String
  client            String?
  description       String?
  estimatedValue    Float?
  expectedCloseDate DateTime?
  outcome           PresalesOutcome @default(OPEN)
  lostReason        String? // set when outcome = LOST
  wonProjectId      String?         @unique
  wonProject        Project?        @relation(fields: [wonProjectId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id])
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  decisions      PresalesDecisionItem[]
  actionItems    PresalesActionItem[]
  checklistItems PresalesChecklistItem[]

  @@index([outcome])
}

model PresalesDecisionItem {
  id                String          @id @default(cuid())
  presalesProjectId String
  presalesProject   PresalesProject @relation(fields: [presalesProjectId], references: [id], onDelete: Cascade)
  order             Int             @default(0)
  date              DateTime?
  decision          String
  rationale         String?
  decidedBy         String? // legacy free-text name; prefer decidedByPersonId once set
  decidedByPersonId String?
  decidedByPerson   Person?         @relation(fields: [decidedByPersonId], references: [id], onDelete: SetNull)
  notes             String?

  @@index([presalesProjectId])
}

model PresalesActionItem {
  id                String          @id @default(cuid())
  presalesProjectId String
  presalesProject   PresalesProject @relation(fields: [presalesProjectId], references: [id], onDelete: Cascade)
  order             Int             @default(0)
  description       String
  ownerPersonId     String?
  ownerPerson       Person?         @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  owner             String? // legacy free-text name; prefer ownerPersonId once set
  dueDate           DateTime?
  status            String          @default("Open") // "Open" | "Done"
  notes             String?

  @@index([presalesProjectId])
}

/// Admin-managed playbook — flat (no stage grouping; presales is a much
/// shorter, single-phase process than delivery). Deliberately a separate
/// table from ChecklistTemplateItem: that one's `type` is tied to the
/// ChecklistType/ModuleName system (PM/DEVOPS), which Presales isn't part of.
model PresalesChecklistTemplateItem {
  id       String @id @default(cuid())
  order    Int    @unique
  itemText String
}

/// Per-opportunity instance of the template above. On Win, these are copied
/// into the resulting Project's ChecklistItem table (type: "PM", stage:
/// "Presales") — see winPresalesProject in app/presales/actions.ts.
model PresalesChecklistItem {
  id                String          @id @default(cuid())
  presalesProjectId String
  presalesProject   PresalesProject @relation(fields: [presalesProjectId], references: [id], onDelete: Cascade)
  order             Int
  itemText          String
  status            String          @default("NOT_STARTED") // see ItemStatus in lib/constants.ts
  plannedDate       DateTime?
  forecastDate      DateTime?
  owner             String? // legacy free-text name; prefer ownerPersonId once set
  ownerPersonId     String?
  ownerPerson       Person?         @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  notes             String?
  isCustom          Boolean         @default(false) // false = seeded from the template; true = added ad hoc

  @@index([presalesProjectId])
}

/// A person's lightweight staffing on one project: role, coarse intensity,
/// and a date range. Not a scheduling tool — just enough to reason about how
/// stretched someone is across projects.
model ProjectEngagement {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleOnProject String // free text, defaults to Person.title, editable per engagement
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  months ProjectEngagementMonth[]

  @@index([projectId])
}

// One row per calendar month an engagement has an explicit intensity set.
// `month` is normalized to the 1st of the month (UTC midnight). A month
// with no row here simply hasn't been set yet — resolved as 0% by
// intensityForMonth() (lib/overload.ts), never inherited from a
// neighboring month.
model ProjectEngagementMonth {
  id           String            @id @default(cuid())
  engagementId String
  engagement   ProjectEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  month        DateTime
  intensityPct Int

  @@unique([engagementId, month])
  @@index([engagementId])
}

/// A major delivery checkpoint (Requirements Baseline, MVP Complete, UAT
/// Sign-off, Production Release, ...) — distinct from a WbsTask (a unit of
/// work) and from a Release (a version/build being shipped). Planned/
/// Forecast/Actual + status/pctComplete give PMO-style variance reporting;
/// the optional links below let a milestone roll up WBS/Sprint/checklist
/// evidence and a Release without duplicating any of their data.
model Milestone {
  id                 String        @id @default(cuid())
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  type               MilestoneType @default(DEVELOPMENT)
  description        String?
  plannedDate        DateTime?
  forecastDate       DateTime?
  actualDate         DateTime?
  status             String        @default("NOT_STARTED") // see ItemStatus in lib/constants.ts
  pctComplete        Float         @default(0)
  ownerPersonId      String?
  ownerPerson        Person?       @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  acceptanceCriteria String?
  dependenciesNote   String? // free-text; formal blocking links are MilestoneDependency below
  order              Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payment        MilestonePayment?
  checklistItems ChecklistItem[]
  wbsTasks       WbsTask[]
  sprints        MilestoneSprint[]
  releases       Release[]
  uatCases       UatCase[]
  blockedBy      MilestoneDependency[] @relation("BlockedMilestone")
  blocks         MilestoneDependency[] @relation("BlockingMilestone")

  @@index([projectId])
}

/// Formal milestone-to-milestone blocking relationship — distinct from
/// DependencyItem, which tracks waits on external parties, not other
/// milestones.
model MilestoneDependency {
  id                  String    @id @default(cuid())
  blockedMilestoneId  String
  blockedMilestone    Milestone @relation("BlockedMilestone", fields: [blockedMilestoneId], references: [id], onDelete: Cascade)
  blockingMilestoneId String
  blockingMilestone   Milestone @relation("BlockingMilestone", fields: [blockingMilestoneId], references: [id], onDelete: Cascade)

  @@unique([blockedMilestoneId, blockingMilestoneId])
}

/// Join table: which sprint(s) a milestone spans, where that's meaningful.
model MilestoneSprint {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  sprintId    String
  sprint      Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, sprintId])
}

/// A version/build being shipped to an environment — distinct from a
/// Milestone (a checkpoint like "Development Complete"). "Version 1.4.0
/// deployed to UAT" is a Release; "Development Complete" is a Milestone.
model Release {
  id                    String      @id @default(cuid())
  projectId             String
  project               Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version               String
  name                  String
  type                  ReleaseType @default(INTERNAL)
  environment           String?
  releaseDate           DateTime?
  ownerPersonId         String?
  ownerPerson           Person?     @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  relatedMilestoneId    String?
  relatedMilestone      Milestone?  @relation(fields: [relatedMilestoneId], references: [id], onDelete: SetNull)
  buildNumber           String?
  releaseNotes          String?
  deploymentStatus      String      @default("Planned") // see RELEASE_DEPLOYMENT_STATUSES in lib/constants.ts
  rollbackVersion       String?
  approvalStatus        String      @default("Pending") // see RELEASE_APPROVAL_STATUSES in lib/constants.ts
  postReleaseValidation String?
  knownIssues           String?
  // UAT closure lives here rather than a separate entity — "has the client
  // accepted this build" is naturally an attribute of the release being
  // tested, not a freestanding concept. See UAT_SIGNOFF_STATUSES in
  // lib/constants.ts.
  uatSignoffStatus String    @default("Pending")
  uatSignoffDate   DateTime?
  uatFeedback      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sprints    ReleaseSprint[]
  wbsTasks   ReleaseWbsTask[]
  uatCases   UatCase[]
  uatDefects UatDefect[]

  @@unique([projectId, version])
  @@index([projectId])
}

/// Join table: which sprint(s) contributed to a release.
model ReleaseSprint {
  id        String  @id @default(cuid())
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  sprintId  String
  sprint    Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([releaseId, sprintId])
}

/// Join table: which WBS tasks are included in a release ("Included WBS").
model ReleaseWbsTask {
  id        String  @id @default(cuid())
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  wbsTaskId String
  wbsTask   WbsTask @relation(fields: [wbsTaskId], references: [id], onDelete: Cascade)

  @@unique([releaseId, wbsTaskId])
}

/// A UAT test scenario/case, distinct from internal QA — this is the
/// client/user acceptance layer. Optionally scoped to a Release and/or
/// Milestone without duplicating either.
model UatCase {
  id             String     @id @default(cuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseId      String?
  release        Release?   @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  milestoneId    String?
  milestone      Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  code           String?
  title          String
  scenario       String?
  preconditions  String?
  steps          String?
  expectedResult String?
  priority       String     @default("Medium") // see RISK_LEVELS in lib/constants.ts
  status         String     @default("NOT_STARTED") // see UAT_CASE_STATUSES in lib/constants.ts
  ownerPersonId  String?
  ownerPerson    Person?    @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  executedDate   DateTime?
  actualResult   String?
  notes          String?
  order          Int        @default(0)
  createdAt      DateTime   @default(now())

  defects UatDefect[]

  @@index([projectId])
  @@index([releaseId])
}

/// A defect logged during UAT execution — distinct from internal QA
/// defects (tracked, if at all, inside the QA checklist), since UAT
/// defects represent client/user-facing acceptance blockers.
model UatDefect {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uatCaseId     String?
  uatCase       UatCase?  @relation(fields: [uatCaseId], references: [id], onDelete: SetNull)
  releaseId     String?
  release       Release?  @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  code          String?
  title         String
  description   String?
  severity      String    @default("Medium") // see UAT_DEFECT_SEVERITIES in lib/constants.ts
  priority      String    @default("Medium") // see RISK_LEVELS in lib/constants.ts
  status        String    @default("Open") // see UAT_DEFECT_STATUSES in lib/constants.ts
  ownerPersonId String?
  ownerPerson   Person?   @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  reportedDate  DateTime?
  targetFixDate DateTime?
  retestResult  String?
  closedDate    DateTime?
  notes         String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([projectId])
  @@index([uatCaseId])
}
