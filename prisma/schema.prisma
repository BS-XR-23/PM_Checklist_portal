generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TPM
  PROGRAM_MANAGER
  CLIENT
  PM
  LIMITED
}

enum ModuleName {
  DASHBOARD
  PM_CHECKLIST
  DEVOPS_CHECKLIST
  MILESTONES
  RISK_REGISTER
  CR_LOG
  BUDGET_TRACKER
  PM_PLAN
}

enum AccessLevel {
  NONE
  READ_LIMITED
  READ_FULL
  WRITE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(LIMITED)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships       ProjectMembership[]
  auditLogs         AuditLog[]
  escalationsRaised EscalationItem[]
  person            Person?
}

model Project {
  id             String   @id @default(cuid())
  name           String
  client         String?
  contractValue  Float    @default(0)
  plannedManDays Float    @default(0)
  crRate         Float    @default(0)
  status         ProjectStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checklistItems ChecklistItem[]
  risks          RiskItem[]
  changeRequests ChangeRequest[]
  budgetEntries  BudgetEntry[]
  pmPlan         PMPlan?
  memberships    ProjectMembership[]
  auditLogs      AuditLog[]
  escalations    EscalationItem[]
  engagements    ProjectEngagement[]
}

/// A user's access to one specific project. Only meaningful for PM/CLIENT/LIMITED
/// roles — ADMIN/TPM/PROGRAM_MANAGER get their scope from their global Role alone
/// and don't need a row here.
model ProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  permissions ModulePermission[]

  @@unique([userId, projectId])
}

/// Per-module access override, consulted only for CLIENT / LIMITED members.
/// Absence of a row means NONE (secure by default).
model ModulePermission {
  id           String            @id @default(cuid())
  membershipId String
  membership   ProjectMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  module       ModuleName
  access       AccessLevel

  @@unique([membershipId, module])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actorRole  Role
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  summary    String
  diff       Json?
  isOverride Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// TPM's dedicated write surface — deliberately never touches the 7 project-data
/// tables, so a TPM cannot silently edit a PM's checklist/milestone/risk/CR/budget.
model EscalationItem {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  title       String
  notes       String?
  status      String   @default("Open")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model ChecklistItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String // "PM" | "DEVOPS" -- see lib/constants.ts
  order         Int
  stage         String
  itemText      String
  milestoneName String?
  owner         String? // legacy free-text name; prefer ownerPersonId once set
  ownerPersonId String?
  ownerPerson   Person?   @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  plannedDate   DateTime?
  forecastDate  DateTime?
  status        String    @default("NOT_STARTED") // see ItemStatus in lib/constants.ts
  notes         String?
  isCustom      Boolean   @default(false) // true only for items added via "+ Add Item" / "Add Milestone", never the fixed template

  milestonePayment MilestonePayment?

  @@unique([projectId, type, order])
}

/// The editable master checklist — lib/create-project.ts copies this into a
/// new project's ChecklistItem rows once, at creation. Deliberately has no
/// relation back to Project/ChecklistItem: editing or deleting a row here
/// only affects projects created afterward, never existing ones.
model ChecklistTemplateItem {
  id            String  @id @default(cuid())
  type          String // "PM" | "DEVOPS" -- see ChecklistType in lib/constants.ts
  order         Int
  stage         String
  itemText      String
  milestoneName String?

  @@unique([type, order])
}

model MilestonePayment {
  id              String        @id @default(cuid())
  checklistItemId String        @unique
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  paymentPct      Float         @default(0)
  invoiceStatus   String        @default("Not Invoiced")
  clientSignoff   String        @default("Pending")
  notes           String?
}

model RiskItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String    @default("Risk")
  category      String?
  description   String
  probability   String    @default("Medium")
  impact        String    @default("Medium")
  owner         String? // legacy free-text name; prefer ownerPersonId once set
  ownerPersonId String?
  ownerPerson   Person?   @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  mitigation    String?
  status        String    @default("Open")
  dateRaised    DateTime?
  dateClosed    DateTime?
  notes         String?
  order         Int       @default(0)
}

model ChangeRequest {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crCode          String
  title           String
  dateRaised      DateTime?
  description     String?
  manDaysPlanned  Float?
  billableManDays Float?
  rate            Float?
  type            String    @default("Paid")
  clientSignoff   String    @default("Pending")
  wbsUpdated      String    @default("No")
  status          String    @default("Proposed")
  notes           String?

  @@unique([projectId, crCode])
}

model BudgetEntry {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekEnding         DateTime
  pctPlannedComplete Float
  pctActualComplete  Float
  actualCost         Float
  notes              String?

  @@unique([projectId, weekEnding])
}

model PMPlan {
  id         String    @id @default(cuid())
  projectId  String    @unique
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preparedBy String?
  planDate   DateTime?
  version    String    @default("1.0")
  rationale  String?

  charterObjective       String?
  charterScopeIn         String?
  charterScopeOut        String?
  charterSuccessCriteria String?
  charterTimeline        String?
  charterBudget          String?
  charterAssumptions     String?
  charterPmAuthority     String?

  methodApproach   String?
  methodCadence    String?
  methodCeremonies String?
  methodTools      String?
  methodRoles      String?
  methodChangeMgmt String?

  testLevels        String?
  testEnvironments  String?
  testEntryCriteria String?
  testExitCriteria  String?
  testDefectMgmt    String?
  testUatProcess    String?
  testDeliverables  String?

  deployEnvironments    String?
  deployReleaseStrategy String?
  deploySteps           String?
  deployRollback        String?
  deployGoliveChecklist String?
  deployMonitoring      String?

  escalationPath String?

  stakeholders StakeholderRow[]
  commsRows    CommsRow[]
  raciRows     RaciRow[]
}

model StakeholderRow {
  id             String  @id @default(cuid())
  pmPlanId       String
  pmPlan         PMPlan  @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  order          Int
  stakeholder    String // legacy free-text name/label; prefer personId once set
  personId       String?
  person         Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  role           String
  responsibility String
  accessRequired String
}

model CommsRow {
  id        String @id @default(cuid())
  pmPlanId  String
  pmPlan    PMPlan @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  order     Int
  audience  String
  frequency String
  channel   String
  content   String
}

model RaciRow {
  id           String @id @default(cuid())
  pmPlanId     String
  pmPlan       PMPlan @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  order        Int
  activity     String
  pm           String
  tl           String
  ba           String
  leadEng      String
  creativeLead String
}

/// Canonical registry of a real person — the single source of truth that
/// checklist "Owner", risk "Owner", and stakeholder names should reference
/// instead of re-typing free text on every row.
model Person {
  id        String   @id @default(cuid())
  name      String
  title     String? // e.g. "Lead Engineer", "Creative Lead", "QA", "BA"
  email     String?
  phone     String?
  userId    String?  @unique // linked portal account, if they have one (typically LIMITED)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  engagements     ProjectEngagement[]
  checklistOwners ChecklistItem[]
  riskOwners      RiskItem[]
  stakeholderRows StakeholderRow[]
}

/// A person's lightweight staffing on one project: role, coarse intensity,
/// and a date range. Not a scheduling tool — just enough to reason about how
/// stretched someone is across projects.
model ProjectEngagement {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleOnProject String // free text, defaults to Person.title, editable per engagement
  intensityPct  Int // 0-100; UI presents Low/Med/High bands over this one number
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
}
