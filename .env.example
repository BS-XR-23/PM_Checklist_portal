# Supabase → Connect button → "Direct" tab → Session pooler.
# We use the Session pooler (port 5432) for both vars: it's IPv4-compatible and
# well suited to this app's deployment model (one long-running Docker
# container, not serverless functions). If you'd rather use the Transaction
# pooler (port 6543, add ?pgbouncer=true) for DATABASE_URL, that works too —
# just keep DIRECT_URL on a non-pgbouncer connection since migrations need it.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Used only by `npm run db:seed` to create the first admin user.
SEED_ADMIN_EMAIL="pm@bs23.local"
SEED_ADMIN_NAME="Admin PM"
SEED_ADMIN_PASSWORD="changeme123"
